label_data_abroad <- fulldf_map %>%
dplyr::filter(Division == "Per Region", Stats == "Members" & Region != "SBBE24" ) %>%
{ if (filter_abroad_only) dplyr::filter(., Region == "Exterior") else . }
Map <- ggplot() +
