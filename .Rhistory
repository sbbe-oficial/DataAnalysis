axis.title = element_blank(),
axis.ticks = element_blank(),
strip.text = element_markdown(family = "Cormorant", size = 86, face = "bold", lineheight = .21),
strip.background = element_rect(colour = "#000000", fill = "#d6d6d6", linewidth = .25)) +
