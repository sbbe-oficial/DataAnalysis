scale_fill_manual(values = c("#006d2c", "#2ca25f", "#66c2a4", "#99d8c9", "#ccece6", "#edf8fb")) +
theme(plot.margin = margin(t = 0, b = 0, r = 0, l = 0, unit = "cm"),
panel.background = element_rect(fill = "#ffffff"),
panel.border = element_blank(),
panel.grid = element_blank(),
legend.position = c(.2, .3),
axis.title = element_blank(),
axis.text = element_blank(),
axis.line = element_blank(),
axis.ticks = element_blank(),
strip.text = element_blank()) +
guides(fill = guide_legend(title = "Biomes of Brazil", title.theme = element_text(family = "Cormorant", size = 14, face = "bold"),
label.theme = element_text(family = "Cormorant", size = 14),
override.aes = list(size = 3)), colour = "#000000")
# Saves Article Map ~
ggsave("./SBBEPlots/ArticleMap.pdf", Map_Article,
device = "pdf", limitsize = FALSE, scale = 1, width = 8, height = 8, dpi = 600)
